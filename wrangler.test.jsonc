{
	// Same as wrangler.jsonc without the AI Search binding, which only runs remotely and would need Cloudflare credentials in tests.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zotero-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
		// Your Zero Trust team domain, and the Application Audience (AUD) tag of the Access application in front of this Worker.
		"ACCESS_TEAM_DOMAIN": "hyperreal.cloudflareaccess.com",
		"ACCESS_AUD": "<set in step 4 of the README>",
		// The AI Search instance the sync fills and semantic_search reads. The Worker creates it on first sync.
		"AI_SEARCH_INSTANCE": "zotero",
		// Outside requests one sync run may make. The Workers Free plan allows 50 per invocation; raise this on a paid plan to index faster.
		"SYNC_REQUEST_BUDGET": "45"
	},
	"kv_namespaces": [{ "binding": "SYNC_STATE" }],
	"triggers": { "crons": ["*/10 * * * *"] },
	"observability": { "enabled": true },
	"dev": { "port": 8789 },
	"secrets": { "required": ["ZOTERO_API_KEY", "ZOTERO_USER_ID"] }
}
